---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, absoluteUrl } from "../site.config";

const steps = [
  { name: "Paste your script", text: "Open the teleprompter and paste plain text into the editor. The word count and estimated reading time appear below it. Your draft is saved in this browser when local storage is available; keep a separate backup of important scripts." },
  { name: "Start, pause and set your pace", text: "Press Start teleprompter to reveal the script and controls. Scrolling begins after the optional 3-2-1 countdown. Press Pause, then adjust Speed, Font size, Line height and Column width. The default speed is 130 words per minute; rehearse and change it to match your delivery." },
  { name: "Float the script or use fullscreen", text: "In supported desktop Chrome or Edge, click Float on top to move the script into its own always-on-top window. Place it near your webcam. Other browsers use in-page or Fullscreen reading; mobile fullscreen may fill the browser viewport rather than use native system fullscreen. Set Mirror before entering fullscreen if you read through a beam-splitter rig. On touch-only phones or iPad, tap Play to resume before entering Fullscreen; playback controls stay outside the fullscreen stage." },
  { name: "Resume and check your recording", text: "On touch-only devices, exit Fullscreen to access Play/Pause, Restart and settings. On desktop, with the teleprompter tab or floating script focused, press Space to resume, including in fullscreen. Arrow keys adjust speed, R resets position and M toggles mirror. Shortcuts do not work while another app or a text field has focus. Media play/pause may work on supported desktop browsers; test it before recording. Share or capture the intended window or tab and check the audience preview or a short recording for visible script text." },
];
const howToSchema = {
  "@context": "https://schema.org", "@type": "HowTo",
  "@id": `${absoluteUrl("/how-it-works")}#howto`,
  name: `How to use ${site.name}`,
  description: "Set up a browser teleprompter for recording, meetings or a hardware rig.",
  step: steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.name, text: s.text, url: `${absoluteUrl("/how-it-works")}#step-${i + 1}` })),
};
---
<Layout title="How to Use the Teleprompter" description="Paste a script, start and pause to adjust settings, then float the teleprompter over your recording app or read fullscreen. Browser and keyboard limits explained." jsonLd={[howToSchema]}>
  <Header compact />
  <main class="setup-guide mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Read your script near the camera</h1>
    <p class="mt-6 text-lg text-[var(--color-fg-muted)]">{site.name} keeps your script alongside your recording or meeting app. Desktop Chrome and Edge support the floating window; other browsers use in-page or fullscreen reading.</p>
    <ol class="mt-12 space-y-12">
      {steps.map((s, i) => <li class="scroll-mt-24" id={`step-${i + 1}`}><h2 class="text-2xl font-semibold">{i + 1}. {s.name}</h2><p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">{s.text}</p></li>)}
    </ol>
    <section class="mt-12 border-t border-[var(--color-border)] pt-8" aria-labelledby="specific-setup">
      <h2 id="specific-setup" class="text-2xl font-semibold">Find the guide for your setup</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        <li><a href="/guides/teleprompter-for-zoom/">Teleprompter for Zoom</a></li>
        <li><a href="/guides/teleprompter-for-obs/">Teleprompter for OBS Studio</a></li>
        <li><a href="/guides/teleprompter-for-loom/">Teleprompter for Loom</a></li>
        <li><a href="/guides/teleprompter-on-ipad/">Teleprompter on iPad</a></li>
      </ul>
      <p class="mt-5"><a href="/guides/">All teleprompter guides</a> and <a href="/faq/">frequently asked questions</a>.</p>
    </section>
    <section class="mt-12 border-t border-[var(--color-border)] pt-8">
      <h2 class="text-2xl font-semibold">Ready for your next take?</h2>
      <p class="mt-4 text-[var(--color-fg-muted)]">Your script stays in your browser. No signup or script upload.</p>
      <a href="/app/" class="mt-5 inline-block font-semibold">Open the teleprompter</a>
    </section>
  </main>
  <Footer />
</Layout>
<style>
  .setup-guide h1, .setup-guide h2 { overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .setup-guide a { text-decoration: underline; text-underline-offset: 4px; }
  .setup-guide a:focus-visible { outline: 3px solid var(--color-fg); outline-offset: 4px; }
  .setup-guide a:hover { text-decoration-thickness: 2px; }
  .setup-guide a:active { background: var(--color-bg-muted); }
</style>
