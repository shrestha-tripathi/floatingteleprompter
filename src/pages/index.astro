---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";
import { pseoBySlug } from "../data/pseo";
import "../styles/marketing.css";

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${site.url}/#webapp`,
  name: site.name,
  alternateName: ["Free online teleprompter", "Always-on-top teleprompter"],
  url: `${site.url}/app/`,
  description: site.description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows, macOS, Linux, iOS, Android (web browser)",
  browserRequirements: "Floating window requires desktop Chrome or Edge. Other browsers use the in-page or fullscreen teleprompter.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: ["Always-on-top script in desktop Chrome and Edge", "Adjustable auto-scroll from 60 to 300 WPM", "Mirror mode for teleprompter rigs", "Adjustable font size, line height and column width", "Keyboard shortcuts and optional countdown", "Local script storage, no script uploads"],
  isAccessibleForFree: true,
  publisher: { "@id": `${site.url}/#organization` },
};
const workflows = [
  { slug: "teleprompter-for-zoom", label: "Zoom", detail: "Keep your talking points beside the camera." },
  { slug: "teleprompter-for-obs", label: "OBS", detail: "Choose a capture source that excludes your script." },
  { slug: "teleprompter-for-loom", label: "Loom", detail: "Read your walkthrough while recording your screen." },
];
const devices = [
  { slug: "teleprompter-on-mac", label: "Mac" },
  { slug: "teleprompter-on-windows", label: "Windows" },
  { slug: "teleprompter-on-ipad", label: "iPad" },
  { slug: "teleprompter-on-chromebook", label: "Chromebook" },
].filter((d) => pseoBySlug.has(d.slug));
---

<Layout title="Free Online Teleprompter" description="Free online teleprompter with a floating script window for desktop Chrome and Edge. Read over Zoom, OBS or Loom. No signup; your script stays on your device." jsonLd={[webAppSchema]}>
  <Header compact />
  <main class="marketing-home" id="main-content">
    <section class="mk-hero">
      <div class="mk-container mk-hero-grid">
        <div class="mk-hero-copy">
          <h1>Free teleprompter.<br />Always on top.</h1>
          <p>Read your script over Zoom, OBS or Loom while you record.</p>
          <div class="mk-actions">
            <a class="mk-button" href="/app/">Open the teleprompter</a>
            <a class="mk-link" href="/how-it-works/">How it works</a>
          </div>
          <p class="mk-compat">No signup or install. Float on desktop Chrome and Edge.<br />On other browsers, use fullscreen.</p>
        </div>
        <figure class="mk-product">
          <img src="/images/teleprompter-preview.webp" width="1036" height="759" alt="The teleprompter paused with a sample script, an eyeline guide, playback controls and adjustable speed." fetchpriority="high" decoding="async" />
          <figcaption>The actual teleprompter, paused and ready to record.</figcaption>
        </figure>
      </div>
    </section>

    <section class="mk-section mk-setup" aria-labelledby="setup-title">
      <div class="mk-container">
        <h2 id="setup-title">From script to first take</h2>
        <ol class="mk-steps">
          <li><h3>Paste your script</h3><p>Press Start for a countdown and auto-scroll.</p></li>
          <li><h3>Find your pace</h3><p>Pause to adjust speed, text size and width.</p></li>
          <li><h3>Float and record</h3><p>Float on top, position near your webcam and resume.</p></li>
        </ol>
      </div>
    </section>

    <section class="mk-section" aria-labelledby="workflow-title">
      <div class="mk-container">
        <div class="mk-heading-row"><h2 id="workflow-title">Teleprompter setup guides</h2><a class="mk-link" href="/guides/">All teleprompter guides</a></div>
        <div class="mk-workflows">
          {workflows.map((w) => <a href={`/guides/${w.slug}/`} class="mk-workflow"><h3>Teleprompter for {w.label}</h3><p>{w.detail}</p><span class="mk-link">Read the setup guide</span></a>)}
        </div>
      </div>
    </section>

    <section class="mk-section mk-privacy" aria-labelledby="privacy-title">
      <div class="mk-container mk-split">
        <h2 id="privacy-title">Your words.<br />Your browser.</h2>
        <div class="mk-prose"><p>No script upload. Your draft stays in this browser when storage is available.</p><p>The loaded app scrolls offline. Mirror mode supports beam-splitter rigs.</p><a class="mk-link" href="/privacy/">Read the privacy policy</a></div>
      </div>
    </section>

    <section class="mk-section" aria-labelledby="answers-title">
      <div class="mk-container mk-split">
        <div><h2 id="answers-title">Teleprompter questions, answered</h2><a class="mk-link mk-faq-link" href="/faq/">Read the full FAQ</a></div>
        <dl class="mk-answers">
          <div><dt>Is it free?</dt><dd>Yes. No signup or watermark.</dd></div>
          <div><dt>Will others see my script?</dt><dd>Share a specific window or tab. Verify the recording first.</dd></div>
          <div><dt>Does it follow my voice?</dt><dd>No. You control the speed.</dd></div>
          <div><dt>Can I use it on my phone?</dt><dd>Yes. Use fullscreen, not a floating window.</dd></div>
        </dl>
      </div>
    </section>

    <section class="mk-section mk-close" aria-labelledby="start-title">
      <div class="mk-container">
        <h2 id="start-title">Keep the script.<br />Lose the second screen.</h2>
        <a class="mk-button" href="/app/">Open the teleprompter</a>
        <nav class="mk-devices" aria-label="Device setup guides">{devices.map((d) => <a class="mk-link" href={`/guides/${d.slug}/`}>Teleprompter on {d.label}</a>)}</nav>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
